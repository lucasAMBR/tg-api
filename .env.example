# UID/GID do host usados pelo docker-compose (evita arquivos criados como root)
# Descubra os seus com: id -u  /  id -g
UID=1000
GID=1000

# Portas publicadas no PC pelo docker-compose. Fogem das padrões para não conflitar com
# serviços já instalados; se alguma estiver em uso, troque aqui (ver o README)
FORWARD_APP_PORT=18000
FORWARD_REVERB_PORT=18080
FORWARD_LIBRETRANSLATE_PORT=15000
FORWARD_DB_PORT=15432
FORWARD_REDIS_PORT=16379

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL="http://localhost:${FORWARD_APP_PORT}"
# Endereço do front (tg-web), usado nos links das mensagens enviadas aos usuários
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Workers do `php artisan serve` (o container app usa --no-reload para respeitar)
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres do docker-compose (o serviço db cria o banco e o usuário com esses nomes)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=brew_db
DB_USERNAME=brew
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# O Horizon só processa filas do Redis
QUEUE_CONNECTION=redis

# Reverb do docker-compose: a API e o Horizon publicam em reverb:8080 (rede interna)
# e o front conecta em ws://localhost:<FORWARD_REVERB_PORT> com a REVERB_APP_KEY abaixo
REVERB_APP_ID=tg-api
REVERB_APP_KEY=tg-api-key
REVERB_APP_SECRET=tg-api-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Tradução: detecção de idioma no lang-detector e tradução no LibreTranslate
TRANSLATION_URL="http://libretranslate:5000/translate"
TRANSLATION_DETECTION_URL="http://lang-detector/api/v1/detect"
